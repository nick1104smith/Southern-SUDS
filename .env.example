# ==============================================================================
# Booking System v2 — environment reference
# ==============================================================================
# This site has no build step, so these values aren't loaded from a real
# .env file — they're pasted directly into supabase-config.js (frontend) and
# set as Supabase secrets (backend). This file just documents what each one
# is, where it goes, and whether it's safe to expose. See BOOKING-V2-SETUP.md
# for the full walkthrough.

# ---- Frontend (goes in supabase-config.js — safe to expose in the browser) --
# Public Supabase project URL. Found in Supabase Dashboard → Project Settings
# → API → Project URL.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Public "anon" key. Safe to ship to the browser AS LONG AS Row Level
# Security is enabled correctly (supabase/schema.sql does this). Found in
# Project Settings → API → Project API keys → anon / public.
SUPABASE_ANON_KEY=eyJ...

# ---- Backend only — NEVER put these in supabase-config.js or any other -----
# ---- file that ships to the browser. Set with `supabase secrets set`. ------

# Bypasses Row Level Security entirely. Not used by anything in this build —
# listed here only as a reminder of what to never expose, in case a future
# admin feature seems to need it (it almost never does; RLS + the `admins`
# table policy covers the admin dashboard already).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Used by supabase/edge-functions/notify-new-booking to email you when a
# new booking request comes in. Get one free at https://resend.com.
RESEND_API_KEY=re_xxxxxxxx

# Where new-booking email alerts are sent.
NOTIFY_TO_EMAIL=southernsudsmd@gmail.com
